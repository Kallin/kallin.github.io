---
import { getCollection } from 'astro:content';
import { isVisible } from '../utils/posts';

interface Props {
	series: string;
	seriesOrder: number;
	placement: 'top' | 'bottom';
}

const { series, seriesOrder, placement } = Astro.props;

// All *visible* parts of this series, in order. `isVisible` drops drafts in a
// production build, so an unpublished Part 3 simply never shows up here (no dead
// links); in `astro dev` every part is visible so the full series previews.
const parts = (await getCollection('blog', isVisible))
	.filter((p) => p.data.series === series && typeof p.data.seriesOrder === 'number')
	.sort((a, b) => a.data.seriesOrder! - b.data.seriesOrder!);

const idx = parts.findIndex((p) => p.data.seriesOrder === seriesOrder);
const prev = idx > 0 ? parts[idx - 1] : null;
const next = idx >= 0 && idx < parts.length - 1 ? parts[idx + 1] : null;
const href = (p: (typeof parts)[number]) => `/blog/${p.id}/`;
---

{
	placement === 'top' && parts.length > 1 && (
		<nav class="series-crumbs" aria-label="Series parts">
			{parts.map((p) =>
				p.data.seriesOrder === seriesOrder ? (
					<span class="crumb current" aria-current="page">
						Part {p.data.seriesOrder}
					</span>
				) : (
					<a class="crumb" href={href(p)} title={p.data.title}>
						Part {p.data.seriesOrder}
					</a>
				)
			)}
		</nav>
	)
}

{
	placement === 'bottom' && (prev || next) && (
		<nav class="series-updown" aria-label="More in this series">
			{prev ? (
				<a class="updown prev" href={href(prev)}>
					<span class="dir">← Previous</span>
					<span class="lbl">
						Part {prev.data.seriesOrder}: {prev.data.title}
					</span>
				</a>
			) : (
				<span class="updown spacer" />
			)}
			{next ? (
				<a class="updown next" href={href(next)}>
					<span class="dir">Next →</span>
					<span class="lbl">
						Part {next.data.seriesOrder}: {next.data.title}
					</span>
				</a>
			) : (
				<span class="updown spacer" />
			)}
		</nav>
	)
}

<style>
	.series-crumbs {
		display: flex;
		gap: 0.5em;
		justify-content: center;
		flex-wrap: wrap;
		margin: 0.75em 0 0;
	}
	.crumb {
		font-size: 0.85rem;
		padding: 0.25em 0.75em;
		border-radius: 999px;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.crumb.current {
		background: rgb(var(--gray-dark));
		color: white;
		border-color: rgb(var(--gray-dark));
		font-weight: 600;
	}
	.crumb:not(.current):hover {
		border-color: rgb(var(--gray));
		color: rgb(var(--gray-dark));
	}
	.series-updown {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1em;
		margin: 3em 0 0;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.updown {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
		padding: 0.85em 1.1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.updown.next {
		text-align: right;
		align-items: flex-end;
	}
	.updown:hover {
		border-color: rgb(var(--gray));
		box-shadow: var(--box-shadow);
	}
	.updown .dir {
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.updown .lbl {
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.3;
	}
	.updown.spacer {
		border: none;
	}
	@media (max-width: 480px) {
		.series-updown {
			grid-template-columns: 1fr;
		}
	}
</style>
