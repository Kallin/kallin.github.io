---
// The pointer head: the position becomes a summary vector; each legal candidate
// is described by its own features; ONE shared scorer rates every candidate
// against the summary. No fixed slots anywhere.
const CARD_COLORS: Record<string, string> = {
	diamond: '#7aa7d4',
	cloth: '#b06fa0',
	spice: '#c96f4a',
};
const CANDS = [
	{ g: 'diamond', feats: ['good: diamond', 'top token: 7', 'you hold: 0'], w: 61, pct: '0.58' },
	{ g: 'cloth', feats: ['good: cloth', 'top token: 5', 'you hold: 2'], w: 36, pct: '0.34' },
	{ g: 'spice', feats: ['good: spice', 'top token: 3', 'you hold: 0'], w: 9, pct: '0.08' },
];
---

<figure class="ptr">
	<div class="before">
		<span class="plbl">the network so far, from part 2</span>
		<span class="bflow">
			<span class="bbox">the position<i>78 numbers</i></span>
			<b class="barr">→</b>
			<span class="bbox">the trunk<i>dials and layers</i></span>
			<b class="barr">→</b>
			<span class="brow">
				<span class="bsec">which action <i>4 slots</i></span>
				<span class="bsec bad">take <i>one slot per card</i></span>
				<span class="bsec">sell <i>6 slots</i></span>
				<span class="bsec">how many <i>5 slots</i></span>
			</span>
		</span>
	</div>

	<div class="nowlbl plbl">the same network, new head</div>

	<div class="stagegrid">
		<div class="col col-state">
			<span class="plbl">the position</span>
			<div class="statebox">market, hands, tokens,<br />herds: 78 numbers</div>
			<span class="arrow">↓ trunk</span>
			<div class="hbox">
				<b>h</b>
				<i>a summary of what<br />matters right now</i>
				<em class="tag tag-q">the query</em>
			</div>
		</div>

		<div class="col col-cands">
			<span class="plbl">the legal moves, each described by its own features <em class="tag tag-k">the keys</em></span>
			<div class="cands">
				{CANDS.map((c) => (
					<div class="cand" style={`--cc:${CARD_COLORS[c.g]}`}>
						<span class="cname">take a {c.g}</span>
						<span class="feats">
							{c.feats.map((f) => (
								<i>{f}</i>
							))}
						</span>
						<span class="score">
							<span class="strack"><span class="sfill" style={`--w:${c.w}%`}></span></span>
							<b>{c.pct}</b>
						</span>
					</div>
				))}
			</div>
		</div>
	</div>

	<div class="sharednote">
		one shared scorer <b>f(h, move)</b> asks the same question of every candidate:
		<em>how good is this move, here?</em>
	</div>

	<div class="ptr-controls">
		<button class="ptr-back" type="button">← Back</button>
		<span class="ptr-count"></span>
		<button class="ptr-next" type="button">Next →</button>
	</div>

	<figcaption class="ptr-caption" aria-live="polite"></figcaption>
</figure>

<style>
	.ptr {
		margin: 1.5rem 0 0.5rem;
		padding: 1.2rem 1.2rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
	}
	.before {
		padding-bottom: 0.8rem;
		margin-bottom: 0.8rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		transition: opacity 0.35s ease;
	}
	.bflow {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.45rem;
	}
	.bbox {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.05rem;
		padding: 0.35em 0.6em;
		border: 1.5px solid rgb(var(--gray-light));
		border-radius: 8px;
		font-size: 0.76rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.bbox i,
	.bsec i {
		font-style: normal;
		font-size: 0.64rem;
		font-weight: 600;
		color: rgb(var(--gray));
	}
	.barr {
		align-self: center;
		font-size: 1.2rem;
		color: rgb(var(--gray-light));
	}
	.brow {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.3rem;
		padding: 0.3em 0.4em;
		border: 1.5px dashed rgb(var(--gray));
		border-radius: 9px;
	}
	.bsec {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0.2em 0.5em;
		border: 1.5px solid rgb(var(--gray-light));
		border-radius: 6px;
		font-size: 0.72rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
		background: #fff;
	}
	.bsec.bad {
		border-color: #b4341f;
		background: #faf1ee;
	}
	.bsec.bad i {
		color: #b4341f;
	}
	.nowlbl {
		margin-bottom: 0.35rem;
	}
	/* step 1 spotlights the before-band; later steps dim it and light the new head */
	.ptr:not(.now) .stagegrid,
	.ptr:not(.now) .nowlbl {
		opacity: 0.4;
	}
	.ptr.now .before {
		opacity: 0.4;
	}
	.stagegrid {
		display: grid;
		grid-template-columns: 168px 1fr;
		gap: 1.1rem;
		align-items: start;
		margin-bottom: 0.6rem;
		transition: opacity 0.35s ease;
	}
	.plbl {
		display: block;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 0.35rem;
	}
	.statebox,
	.hbox {
		border: 1.5px solid rgb(var(--gray-light));
		border-radius: 9px;
		padding: 0.5em 0.6em;
		font-size: 0.72rem;
		color: rgb(var(--gray-dark));
		text-align: center;
		line-height: 1.35;
	}
	.hbox {
		border-color: var(--accent);
		background: #eef1ff;
	}
	.hbox b {
		display: block;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}
	.hbox i {
		font-style: normal;
		font-size: 0.66rem;
		color: rgb(var(--gray));
	}
	.arrow {
		display: block;
		text-align: center;
		font-size: 0.72rem;
		color: rgb(var(--gray));
		margin: 0.25rem 0;
	}
	.cands {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.cand {
		display: grid;
		grid-template-columns: 108px 1fr 148px;
		align-items: center;
		gap: 0.6em;
		border: 1.5px solid var(--cc);
		background: color-mix(in srgb, var(--cc) 9%, white);
		border-radius: 9px;
		padding: 0.4em 0.55em;
	}
	.cname {
		font-size: 0.76rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.feats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
	}
	.feats i {
		font-style: normal;
		font-size: 0.66rem;
		color: rgb(var(--gray));
		white-space: nowrap;
		visibility: hidden;
	}
	.ptr.s2 .feats i {
		visibility: visible;
	}
	.score {
		display: flex;
		align-items: center;
		gap: 0.4em;
		visibility: hidden;
	}
	.ptr.s3 .score {
		visibility: visible;
	}
	.strack {
		position: relative;
		flex: 1;
		height: 9px;
		background: rgb(var(--gray-light));
		border-radius: 3px;
	}
	.sfill {
		position: absolute;
		inset: 0 auto 0 0;
		width: var(--w);
		background: var(--accent);
		border-radius: 3px;
	}
	.score b {
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--gray-dark));
		min-width: 2.4em;
		text-align: right;
	}
	.tag {
		display: inline-block;
		white-space: nowrap;
		font-style: normal;
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #b4341f;
		border: 1.5px solid #b4341f;
		border-radius: 999px;
		padding: 0.05em 0.5em;
		visibility: hidden;
		opacity: 0;
		transition: opacity 0.35s ease;
	}
	.hbox .tag {
		display: block;
		width: fit-content;
		margin: 0.3rem auto 0;
	}
	.plbl .tag {
		margin-left: 0.4rem;
		vertical-align: middle;
	}
	.ptr.s4 .tag {
		visibility: visible;
		opacity: 1;
	}
	.sharednote {
		font-size: 0.84rem;
		color: rgb(var(--gray-dark));
		text-align: center;
		margin-bottom: 0.2rem;
		visibility: hidden;
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.ptr.s3 .sharednote {
		visibility: visible;
		opacity: 1;
	}
	.sharednote em {
		font-style: normal;
		color: rgb(var(--gray));
	}
	.ptr-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.9rem;
		padding-top: 0.6rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.ptr-controls button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35em 1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.ptr-controls button:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.ptr-controls button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.ptr-count {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		min-width: 3.5em;
		text-align: center;
	}
	.ptr-caption {
		min-height: 9em;
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}
	@media (max-width: 560px) {
		.stagegrid {
			grid-template-columns: 1fr;
		}
		.cand {
			grid-template-columns: 96px 1fr;
		}
		.score {
			grid-column: 1 / -1;
		}
	}
</style>

<script>
	type Step = { caption: string; cls: string[] };

	const STEPS: Step[] = [
		{
			caption:
				'The top row is the network as Part 2 left it: the observation, the trunk, and a head that is one long fixed row of slots, a section for each question in the interview. When the engine asks a question, the matching section answers; the others are masked off. The red section is the take question, one slot per physical card, the moving addresses the codec demo just exposed. The interview itself is fine. The row is the problem.',
			cls: [],
		},
		{
			caption:
				'So keep everything except the row. Same observation, same trunk, every dial intact; only the head is amputated. The trunk now ends in a single summary vector, h: an opinion about what matters right now, with no moves attached to it at all. The engine still asks one question at a time, exactly as before. What changes is how each answer gets expressed.',
			cls: ['now'],
		},
		{
			caption:
				'Now the moves. Each legal candidate arrives described by its own features, what it IS rather than where it sits: which good, what the top token pays, how many you already hold. A move is a bundle of properties. Notice what disappeared: there is no slot 2. If a different deal offers different takes, there are simply different bundles.',
			cls: ['now', 's2'],
		},
		{
			caption:
				'One shared scorer, itself a small feed-forward net, reads the summary and one candidate at a time: how good is this move, in this situation? Same dials for every candidate, so what it learns about "a high-token good you already collect" transfers to every move that ever fits that description. The scores become probabilities over exactly the legal set, however many there are. Trained exactly as before, take-accuracy went from 80% to 95%, and the agent from 18.5% to parity.',
			cls: ['now', 's2', 's3'],
		},
		{
			caption:
				'This pattern has a name. One query compared against every member of a set by a shared judgment, softmax over the scores: that is attention, the mechanism modern language models are built from. When an LLM picks its next word, it scores its context vector against every word it knows, exactly this shape. The difference is what the softmax is for: a transformer uses the scores to decide how much to blend, and a pointer head uses them to choose. The answer points at one of the inputs, which is why there is no slot for it to need.',
			cls: ['now', 's2', 's3', 's4'],
		},
	];

	document.querySelectorAll<HTMLElement>('.ptr').forEach((root) => {
		const back = root.querySelector<HTMLButtonElement>('.ptr-back')!;
		const next = root.querySelector<HTMLButtonElement>('.ptr-next')!;
		const count = root.querySelector('.ptr-count')!;
		const caption = root.querySelector('.ptr-caption')!;
		const ALL = ['now', 's2', 's3', 's4'];
		let i = 0;

		const render = () => {
			const s = STEPS[i];
			ALL.forEach((c) => root.classList.remove(c));
			s.cls.forEach((c) => root.classList.add(c));
			caption.textContent = s.caption;
			count.textContent = `${i + 1} / ${STEPS.length}`;
			back.disabled = i === 0;
			next.disabled = i === STEPS.length - 1;
		};

		back.addEventListener('click', () => {
			if (i > 0) i -= 1;
			render();
		});
		next.addEventListener('click', () => {
			if (i < STEPS.length - 1) i += 1;
			render();
		});
		render();
	});
</script>
