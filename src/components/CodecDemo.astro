---
// The action codec as the old head actually shaped it: ONE fixed answer bar,
// a section per question type, all sections always present and masked down to
// the live one, take slots numbered by POSITION. Same segmented-bar visual
// language as the pointer head's row template later in the post, so the two
// structures can be compared directly.
const CARD_COLORS: Record<string, string> = {
	diamond: '#7aa7d4',
	gold: '#d9a441',
	silver: '#9aa5b1',
	cloth: '#b06fa0',
	spice: '#c96f4a',
	leather: '#9b8360',
	camel: '#c2a171',
};

const DEAL_A = [
	{ id: 14, g: 'cloth' },
	{ id: 27, g: 'diamond' },
	{ id: 33, g: 'spice' },
	{ id: 41, g: 'cloth' },
	{ id: 52, g: 'camel' },
];
const DEAL_B = [
	{ id: 8, g: 'leather' },
	{ id: 19, g: 'gold' },
	{ id: 22, g: 'spice' },
	{ id: 45, g: 'diamond' },
	{ id: 57, g: 'camel' },
];
const SLOTS_A = DEAL_A.filter((c) => c.g !== 'camel');
const SLOTS_B = DEAL_B.filter((c) => c.g !== 'camel');
const TYPES = ['diamond', 'gold', 'silver', 'cloth', 'spice', 'leather'];
---

<figure class="cdc">
	<div class="deal deal-a">
		<span class="dlbl">deal one</span>
		<span class="cards">
			{DEAL_A.map((c) => (
				<span class="card" style={`--cc:${CARD_COLORS[c.g]}`}>{c.g}<i>#{c.id}</i></span>
			))}
		</span>
	</div>

	<div class="barwrap bar-a">
		<span class="slbl">the network's answer row for this deal, one fixed bar of slots</span>
		<span class="obar">
			<span class="oseg dim"><b>which action</b><i>4 slots · masked</i></span>
			{SLOTS_A.map((c, i) => (
				<span class={`oseg take ${c.g === 'diamond' ? 'dia' : ''}`} style={`--cc:${CARD_COLORS[c.g]}`}>
					<b>slot {i + 1}</b><i>#{c.id} {c.g}</i>
				</span>
			))}
			<span class="oseg dim"><b>sell</b><i>6 · masked</i></span>
			<span class="oseg dim"><b>count</b><i>5 · masked</i></span>
		</span>
	</div>

	<div class="deal deal-b">
		<span class="dlbl">deal two</span>
		<span class="cards">
			{DEAL_B.map((c) => (
				<span class="card" style={`--cc:${CARD_COLORS[c.g]}`}>{c.g}<i>#{c.id}</i></span>
			))}
		</span>
	</div>

	<div class="barwrap bar-b">
		<span class="slbl">the same bar, same positions, new deal</span>
		<span class="obar">
			<span class="oseg dim"><b>which action</b><i>4 slots · masked</i></span>
			{SLOTS_B.map((c, i) => (
				<span class={`oseg take ${c.g === 'diamond' ? 'dia' : ''}`} style={`--cc:${CARD_COLORS[c.g]}`}>
					<b>slot {i + 1}</b><i>#{c.id} {c.g}</i>
				</span>
			))}
			<span class="oseg dim"><b>sell</b><i>6 · masked</i></span>
			<span class="oseg dim"><b>count</b><i>5 · masked</i></span>
		</span>
	</div>

	<div class="verdictline">
		"take the diamond" lives at <em>slot 2</em> in deal one and <em>slot 4</em> in deal two.
		The +1 from a won game trains the slot, not the meaning.
	</div>

	<div class="barwrap bar-fix">
		<span class="slbl">the collapsed codec: take slots named by KIND, stable in every deal</span>
		<span class="obar">
			<span class="oseg dim"><b>which action</b><i>4 slots</i></span>
			{TYPES.map((t) => (
				<span class="oseg take" style={`--cc:${CARD_COLORS[t]}`}>
					<b>{t}</b>
				</span>
			))}
			<span class="oseg dim"><b>sell</b><i>6</i></span>
			<span class="oseg dim"><b>count</b><i>5</i></span>
		</span>
	</div>

	<div class="cdc-controls">
		<button class="cdc-back" type="button">← Back</button>
		<span class="cdc-count"></span>
		<button class="cdc-next" type="button">Next →</button>
	</div>

	<figcaption class="cdc-caption" aria-live="polite"></figcaption>
</figure>

<style>
	.cdc {
		margin: 1.5rem 0 0.5rem;
		padding: 1.2rem 1.2rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
	}
	.deal,
	.barwrap,
	.verdictline {
		transition: opacity 0.4s ease;
	}
	.deal {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.4rem;
	}
	.dlbl,
	.slbl {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.slbl {
		display: block;
		margin-bottom: 0.3rem;
		white-space: normal;
	}
	.cards {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.card {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		min-width: 3.9em;
		padding: 0.24em 0.4em;
		border-radius: 7px;
		border: 1.5px solid var(--cc);
		background: color-mix(in srgb, var(--cc) 14%, white);
		font-size: 0.74rem;
		font-weight: 600;
		color: rgb(var(--gray-dark));
		line-height: 1.25;
	}
	.card i {
		font-style: normal;
		font-size: 0.62rem;
		font-weight: 600;
		color: rgb(var(--gray));
	}
	.barwrap {
		margin-bottom: 0.8rem;
	}
	.obar {
		display: flex;
		width: 100%;
		border-radius: 7px;
		overflow: hidden;
	}
	.oseg {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.05rem;
		flex: 1 1 0;
		padding: 0.3em 0.15em;
		border: 1.5px solid rgb(var(--gray-light));
		background: #fff;
		overflow: hidden;
		transition: border-color 0.35s ease, background 0.35s ease;
	}
	.oseg + .oseg {
		border-left-width: 0;
	}
	.oseg b {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: rgb(var(--gray-dark));
		white-space: nowrap;
	}
	.oseg i {
		font-style: normal;
		font-size: 0.62rem;
		font-weight: 600;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.oseg.dim {
		background: #f6f7f9;
	}
	.oseg.dim b,
	.oseg.dim i {
		color: rgb(var(--gray-light));
	}
	.oseg.take {
		background: color-mix(in srgb, var(--cc) 12%, white);
		border-color: color-mix(in srgb, var(--cc) 55%, white);
	}
	.cdc.hl .oseg.take.dia {
		border-color: #b4341f;
		border-left-width: 1.5px;
		background: #faf1ee;
	}
	.cdc.hl .oseg.take.dia b {
		color: #b4341f;
	}
	.verdictline {
		font-size: 0.85rem;
		color: rgb(var(--gray-dark));
		text-align: center;
		margin: 0.1rem 0 0.8rem;
	}
	.verdictline em {
		font-style: normal;
		font-weight: 700;
		color: #b4341f;
	}
	.deal-b,
	.bar-b,
	.verdictline,
	.bar-fix {
		visibility: hidden;
		opacity: 0;
	}
	.cdc.s2 .deal-b,
	.cdc.s2 .bar-b {
		visibility: visible;
		opacity: 1;
	}
	.cdc.s3 .verdictline {
		visibility: visible;
		opacity: 1;
	}
	.cdc.s4 .bar-fix {
		visibility: visible;
		opacity: 1;
	}
	.cdc-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.9rem;
		padding-top: 0.6rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.cdc-controls button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35em 1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.cdc-controls button:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.cdc-controls button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.cdc-count {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		min-width: 3.5em;
		text-align: center;
	}
	.cdc-caption {
		min-height: 156px;
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}
</style>

<script>
	type Step = { caption: string; cls: string[] };

	const STEPS: Step[] = [
		{
			caption:
				'The network\'s output is one fixed bar of slots, a section for every question in the interview, all of them always present. When the engine asks a question, its section opens and the rest are masked to zero; a take decision opens the take section. And look how those slots are named: by POSITION. Slot 1 means "the card the engine listed first," slot 2 the second. The bar is the codec: the agreed mapping from slots to moves.',
			cls: [],
		},
		{
			caption:
				'A new deal, the same bar. The positions are fixed, so each slot simply takes on whatever meaning the new deal gives it. Look at where the diamond went.',
			cls: ['s2'],
		},
		{
			caption:
				'There is the bug. "Take the diamond" has no slot of its own; it inherits whichever position the deal hands it. The backward stamp from a won game pulls slot 2 toward diamonds in one game and toward something else in the next, so slot 2\'s dials end up holding the smeared average of every meaning that ever passed through them. The network is not failing to learn. The lesson is delivered to a different address every time.',
			cls: ['s2', 's3', 'hl'],
		},
		{
			caption:
				'The fix that can be proven tonight: collapse the take section so its slots are named by KIND. The diamond slot means diamonds in every game ever played, and every stamp about diamonds lands on the same dials. Hold onto the shape of this bar, though. The real repair, later in the post, does not rename the slots. It gets rid of the bar.',
			cls: ['s2', 's3', 's4'],
		},
	];

	document.querySelectorAll<HTMLElement>('.cdc').forEach((root) => {
		const back = root.querySelector<HTMLButtonElement>('.cdc-back')!;
		const next = root.querySelector<HTMLButtonElement>('.cdc-next')!;
		const count = root.querySelector('.cdc-count')!;
		const caption = root.querySelector('.cdc-caption')!;
		const ALL = ['s2', 's3', 's4', 'hl'];
		let i = 0;

		const render = () => {
			const s = STEPS[i];
			ALL.forEach((c) => root.classList.remove(c));
			s.cls.forEach((c) => root.classList.add(c));
			caption.textContent = s.caption;
			count.textContent = `${i + 1} / ${STEPS.length}`;
			back.disabled = i === 0;
			next.disabled = i === STEPS.length - 1;
		};

		back.addEventListener('click', () => {
			if (i > 0) i -= 1;
			render();
		});
		next.addEventListener('click', () => {
			if (i < STEPS.length - 1) i += 1;
			render();
		});
		render();
	});
</script>
