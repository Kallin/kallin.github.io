---
// The W0 blindfold finding as a stepped scene: the same Jaipur table rendered
// twice, once as any player at the table sees it and once as the network saw
// it, with the opponent's OPEN information sentineled to -1. Same visual
// grammar as the other demos: fixed layout, class-toggled steps, caption with
// a pinned min-height so nothing shifts.
const CARD_COLORS: Record<string, string> = {
	diamond: '#7aa7d4',
	gold: '#d9a441',
	cloth: '#b06fa0',
	spice: '#c96f4a',
	leather: '#9b8360',
	camel: '#c2a171',
};
const MARKET = ['diamond', 'gold', 'cloth', 'spice', 'camel'];
const HAND = ['gold', 'cloth', 'cloth', 'spice', 'leather'];
const OPP_STATS = [
	{ label: 'cards in hand', open: '5' },
	{ label: 'camels in herd', open: '3' },
	{ label: 'tokens banked', open: '4' },
];
---

<figure class="bfd">
	<div class="zone opp">
		<span class="zlbl">across the table</span>
		<span class="row">
			{OPP_STATS.map((s) => (
				<span class="stat">
					<b class="v-open">{s.open}</b>
					<b class="v-red">&minus;1</b>
					<b class="v-fix">{s.open}</b>
					<i>{s.label}</i>
				</span>
			))}
			<span class="backs">
				{[0, 1, 2, 3, 4].map(() => <span class="back"></span>)}
			</span>
		</span>
	</div>

	<div class="zone mkt">
		<span class="zlbl">the market, face up</span>
		<span class="row">
			{MARKET.map((g) => (
				<span class="card" style={`--cc:${CARD_COLORS[g]}`}>{g}</span>
			))}
		</span>
	</div>

	<div class="zone you">
		<span class="zlbl">your hand</span>
		<span class="row">
			{HAND.map((g) => (
				<span class="card" style={`--cc:${CARD_COLORS[g]}`}>{g}</span>
			))}
		</span>
	</div>

	<div class="legend">
		<span class="leg"><b>counts</b> of every zone: public, always</span>
		<span class="leg"><b>identities</b> in another player's hand: hidden</span>
		<span class="leg"><b>deck order</b> and face-down piles: hidden</span>
	</div>

	<div class="bfd-controls">
		<button class="bfd-back" type="button">&larr; Back</button>
		<span class="bfd-count"></span>
		<button class="bfd-next" type="button">Next &rarr;</button>
	</div>

	<figcaption class="bfd-caption" aria-live="polite"></figcaption>
</figure>

<style>
	.bfd {
		margin: 1.5rem 0 0.5rem;
		padding: 1.2rem 1.2rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
	}
	.zone {
		margin-bottom: 0.7rem;
	}
	.zlbl {
		display: block;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 0.3rem;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.stat {
		display: inline-grid;
		justify-items: center;
		gap: 0.08rem;
		min-width: 6.2em;
		padding: 0.3em 0.5em;
		border: 1.5px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #fff;
		transition: border-color 0.35s ease, background 0.35s ease;
	}
	.stat b {
		grid-area: 1 / 1;
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--gray-dark));
		visibility: hidden;
	}
	.stat i {
		grid-area: 2 / 1;
		font-style: normal;
		font-size: 0.62rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.bfd .stat .v-open { visibility: visible; }
	.bfd.s2 .stat .v-open,
	.bfd.s3 .stat .v-open { visibility: hidden; }
	.bfd.s2 .stat .v-red { visibility: visible; }
	.bfd.s3 .stat .v-red { visibility: hidden; }
	.bfd.s3 .stat .v-fix { visibility: visible; }
	.bfd.s2 .stat {
		border-color: #b4341f;
		background: #faf1ee;
	}
	.bfd.s2 .stat .v-red { color: #b4341f; }
	.bfd.s3 .stat {
		border-color: #177a4c;
		background: #eaf4ee;
	}
	.bfd.s3 .stat .v-fix { color: #177a4c; }
	.backs {
		display: inline-flex;
		gap: 0.22rem;
		margin-left: 0.3rem;
	}
	.back {
		width: 1.5em;
		height: 2.1em;
		border-radius: 5px;
		border: 1.5px solid #8a93b8;
		background: repeating-linear-gradient(45deg, #dfe4f2, #dfe4f2 3px, #cdd4ea 3px, #cdd4ea 6px);
	}
	.card {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 4.2em;
		padding: 0.34em 0.4em;
		border-radius: 7px;
		border: 1.5px solid var(--cc);
		background: color-mix(in srgb, var(--cc) 14%, white);
		font-size: 0.74rem;
		font-weight: 600;
		color: rgb(var(--gray-dark));
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		padding-top: 0.55rem;
		border-top: 1px dashed rgb(var(--gray-light));
		visibility: hidden;
	}
	.bfd.s4 .legend { visibility: visible; }
	.leg {
		font-size: 0.74rem;
		color: rgb(var(--gray));
	}
	.leg b {
		color: rgb(var(--gray-dark));
		font-weight: 700;
	}
	.bfd-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.9rem;
		padding-top: 0.6rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.bfd-controls button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35em 1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.bfd-controls button:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.bfd-controls button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.bfd-count {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		min-width: 3.5em;
		text-align: center;
	}
	.bfd-caption {
		min-height: 120px; /* measured: tallest caption at 1280 and 800; re-measure if captions change */
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}
</style>

<script>
	type Step = { caption: string; cls: string[] };

	const STEPS: Step[] = [
		{
			caption:
				'A Jaipur table, seen from your chair. Your opponent\'s card FACES are hidden, and that is the game being fair. But their numbers are not secrets: anyone at the table can see how many cards they hold, how many camels they have collected, how many tokens they have banked. Open information, sitting in plain view.',
			cls: [],
		},
		{
			caption:
				'The same table, as the network saw it. Every one of those open numbers read as the hidden sentinel, -1. The market and its own hand came through fine; the entire opponent side of the table was a wall of "not for you." It was playing a hidden-information game with more hidden from it than the rules hide.',
			cls: ['s2'],
		},
		{
			caption:
				'The fix took twenty minutes: expose the counts, keep the faces hidden. Not one extra number of secret information crossed the table, and the observation did not even change width; the slots were already there, holding the sentinel. Thirty-eight perspective tests confirm nothing leaks that a player could not see.',
			cls: ['s3'],
		},
		{
			caption:
				'The rule the engine enforces, spelled out. Who may see a zone\'s contents is a property of the zone; the COUNT of a zone is public in essentially every card game ever printed. Hiding identities is the game. Hiding counts was a bug wearing the game\'s uniform.',
			cls: ['s3', 's4'],
		},
	];

	document.querySelectorAll<HTMLElement>('.bfd').forEach((root) => {
		const back = root.querySelector<HTMLButtonElement>('.bfd-back')!;
		const next = root.querySelector<HTMLButtonElement>('.bfd-next')!;
		const count = root.querySelector('.bfd-count')!;
		const caption = root.querySelector('.bfd-caption')!;
		const ALL = ['s2', 's3', 's4'];
		let i = 0;

		const render = () => {
			const s = STEPS[i];
			ALL.forEach((c) => root.classList.remove(c));
			s.cls.forEach((c) => root.classList.add(c));
			caption.textContent = s.caption;
			count.textContent = `${i + 1} / ${STEPS.length}`;
			back.disabled = i === 0;
			next.disabled = i === STEPS.length - 1;
		};

		back.addEventListener('click', () => {
			if (i > 0) i -= 1;
			render();
		});
		next.addEventListener('click', () => {
			if (i < STEPS.length - 1) i += 1;
			render();
		});
		render();
	});
</script>
